// Shareable preview (demo mode + live Luma/Eventbrite event feeds). Deploy: npm run share  (from repo root)
{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "opinion-london",
  "main": "share-worker.ts",
  "compatibility_date": "2026-10-01",
  // app.useopinion.io: Custom Domain (Cloudflare creates the DNS record + certificate on deploy). workers.dev stays on as a fallback.
  "routes": [{ "pattern": "app.useopinion.io", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Optional Eventbrite: `wrangler secret put EVENTBRITE_TOKEN --config wrangler.share.jsonc`
  // and add "vars": { "EVENTBRITE_ORGS": "<org id>,<org id>" }
}
