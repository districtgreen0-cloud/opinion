// Shareable preview (demo mode + live Luma/Eventbrite event feeds). Deploy: npm run share  (from repo root)
{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "opinion-london",
  "main": "share-worker.ts",
  "compatibility_date": "2026-10-01",
  // Demo preview only (app.useopinion.io is served by the full worker in ../worker). Reachable at opinion-london.calderabalkan.workers.dev.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Optional Eventbrite: `wrangler secret put EVENTBRITE_TOKEN --config wrangler.share.jsonc`
  // and add "vars": { "EVENTBRITE_ORGS": "<org id>,<org id>" }
}
